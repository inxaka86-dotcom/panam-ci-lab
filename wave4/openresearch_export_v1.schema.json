{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panam.local/schemas/openresearch.panam-export.v1.json",
  "title": "Bounded OpenResearch developer export V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "upstream", "project", "experiments"],
  "properties": {
    "schema": {"const": "openresearch.panam-export.v1"},
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha", "version"],
      "properties": {
        "repository": {"const": "alphaXiv/OpenResearch"},
        "commit_sha": {"const": "69768ff1b0537a4656e69f550fc444ac35b945d2"},
        "version": {"const": "0.2.5"}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "name"],
      "properties": {
        "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 800}
      }
    },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/experiment"}
    }
  },
  "$defs": {
    "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "status"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "status": {"enum": ["starting", "running", "done", "failed", "cancelled", "unknown"]},
        "result_claim": {"type": ["string", "null"], "maxLength": 800},
        "evidence_refs": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/evidence_ref"}
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "parent_experiment_id",
        "title",
        "branch",
        "commit_sha",
        "source_status"
      ],
      "properties": {
        "experiment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "parent_experiment_id": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "title": {"type": "string", "minLength": 1, "maxLength": 800},
        "branch": {"type": "string", "minLength": 1, "maxLength": 256},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_status": {"enum": ["provisional", "answered", "unknown"]},
        "run": {"anyOf": [{"$ref": "#/$defs/run"}, {"type": "null"}]}
      }
    }
  }
}
