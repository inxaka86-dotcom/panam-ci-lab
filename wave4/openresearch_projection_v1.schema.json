{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panam.local/schemas/panam.openresearch.research-projection.v1.json",
  "title": "PANAM OpenResearch research projection V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "job_binding",
    "upstream",
    "project",
    "source_manifest_sha256",
    "experiments",
    "edges",
    "warnings"
  ],
  "properties": {
    "schema": {"const": "panam.openresearch.research-projection.v1"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_of_truth",
        "projection_only",
        "execution_authorized",
        "owner_approval_satisfied",
        "private_data_eligible"
      ],
      "properties": {
        "source_of_truth": {"const": false},
        "projection_only": {"const": true},
        "execution_authorized": {"const": false},
        "owner_approval_satisfied": {"const": false},
        "private_data_eligible": {"const": false}
      }
    },
    "job_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bound", "authoritative_job_id", "reason"],
      "properties": {
        "bound": {"const": false},
        "authoritative_job_id": {"const": null},
        "reason": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha", "version"],
      "properties": {
        "repository": {"const": "alphaXiv/OpenResearch"},
        "commit_sha": {"const": "69768ff1b0537a4656e69f550fc444ac35b945d2"},
        "version": {"const": "0.2.5"}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "name"],
      "properties": {
        "project_id": {"type": "string"},
        "name": {"type": "string"}
      }
    },
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/experiment"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "run": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["run_id", "source_status", "result_claim", "claim_verification", "evidence_refs"],
      "properties": {
        "run_id": {"type": "string"},
        "source_status": {"type": "string"},
        "result_claim": {"type": ["string", "null"]},
        "claim_verification": {"enum": ["UNVERIFIED_EXTERNAL", "NO_RESULT_CLAIM"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "parent_experiment_id",
        "title",
        "branch",
        "commit_sha",
        "source_status",
        "authority",
        "evidence_refs",
        "run"
      ],
      "properties": {
        "experiment_id": {"type": "string"},
        "parent_experiment_id": {"type": ["string", "null"]},
        "title": {"type": "string"},
        "branch": {"type": "string"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_status": {"enum": ["provisional", "answered", "unknown"]},
        "authority": {"const": "NONE"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "run": {"$ref": "#/$defs/run"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "from", "to", "edge_type"],
      "properties": {
        "edge_id": {"type": "string"},
        "from": {"type": "string"},
        "to": {"type": "string"},
        "edge_type": {"const": "parent_child"}
      }
    }
  }
}
